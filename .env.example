ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
STITCH_API_KEY=
# Contact form service (create a free form at formspree.io or web3forms.com with the owner's email). A project can override these in projects/<id>/form.json
FORM_ENDPOINT=
FORM_ACCESS_KEY=
# Optional: fal.ai key for generated atmosphere pictures with FLUX.2 (never products, people or text)
FAL_KEY=

# Protection (all optional)
# The most the paid AI calls may cost per day (USD). When it is reached, new designs pause until tomorrow. Default 30.
DAILY_BUDGET_USD=30
# Behind a proxy or host that forwards the visitor's address: 1
TRUST_PROXY=
# The team panel only opens on this computer. To use it from elsewhere set TEAM_HOST=0.0.0.0 AND a TEAM_KEY (open it once with /?key=<TEAM_KEY>)
TEAM_HOST=
TEAM_KEY=
# Orders: leave ORDERS_URL empty (a business site and its orders are on the same address). ORDERS_DIR is where each business keeps its database folder
ORDERS_URL=http://localhost:3002
ORDERS_DIR=

# The website assistant (chat bubble, an extra the owner can choose in the form)
# Which model answers customers' questions. Empty: the same as ANTHROPIC_MODEL. A smaller one, for example claude-haiku-5-5, costs much less.
CHAT_MODEL=
# The most one business's assistant may cost per month (USD). When it is used up, visitors are sent to a person (WhatsApp) until next month. Default 5.
CHAT_MONTHLY_BUDGET_USD=5

# Alerts to the owner when an order or an appointment request arrives (each is optional; the owner chooses in the panel under "Alerts").
# Email: an account at resend.com and a verified sending address.
RESEND_API_KEY=
MAIL_FROM=
# WhatsApp: the official WhatsApp Business Cloud API (Meta). A business may only start a chat with an approved message template that has ONE
# body variable ({{1}}, the text of the alert). WHATSAPP_TEMPLATE is its name; WHATSAPP_LANG its language code (default en).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=
# The business's public address (adds "Open your panel" to email alerts), for example https://aljawad.com
PUBLIC_URL=

# Alerts on the phones of the people who run a business (Web Push): no account is needed, each business makes its own keys by itself.
# Only a contact address for the push services (they ask for one). For example https://aljawad.com or mailto:you@yourdomain.com
VAPID_SUBJECT=

# The assistant has two ways the owner picks in the form: "standard" uses CHAT_MODEL above, "economy" uses this smaller, much cheaper model.
CHAT_MODEL_ECONOMY=claude-haiku-5-5
