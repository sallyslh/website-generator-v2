{
  "name": "website-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "node src/cli.js",
    "test": "node --import ./test/setup.mjs --test --test-concurrency=1 \"test/*.test.js\"",
    "customer": "node src/server/customer.js",
    "check": "node tools/check.mjs",
    "orders": "node --disable-warning=ExperimentalWarning src/server/orders/server.js",
    "serve": "node --disable-warning=ExperimentalWarning tools/serve-site.mjs",
    "gallery": "node tools/stitch-gallery.mjs",
    "wow": "node --disable-warning=ExperimentalWarning src/server/wow.js",
    "editor": "node src/server/editor.js",
    "gates": "node tools/gates.mjs",
    "publish": "node tools/publish.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@google/stitch-sdk": "^0.3.5",
    "@inquirer/prompts": "^8.7.3",
    "archiver": "^8.0.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.6",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "description": "Generates complete multi-page websites for small businesses, then lets the owner edit them as content"
}
